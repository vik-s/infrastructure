[Unit]
Description=Autorestic cron
Wants=network-online.target
After=network-online.target

[Service]
User=root
Group=root
Environment=TZ={{ autorestic_timezone }}
Environment=HOME=/root
Type=oneshot
TimeoutStartSec=infinity
ExecStart=/etc/autorestic/autorestic
# Autorestic can hide individual cron failures. Verify actual snapshots.
ExecStartPost=/usr/local/lib/autorestic/autorestic-health.py check
